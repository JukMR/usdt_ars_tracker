# Generated by deploy/install.sh — edit freely, it is never overwritten.
[poller]
interval_seconds = 60

[server]
host = "__HOST__"
port = __PORT__
debug = false
dashboard_refresh_seconds = 10
log_level = "INFO"

[alerts]
default_cooldown_seconds = 3600

[storage]
# Keep ~6 months of history. Set to 0 to keep everything.
retention_days = 180

[providers.binance]
enabled = true
symbols = ["BTCUSDT", "ETHUSDT", "SOLUSDT"]
# Add more pairs as you like, e.g.:
# symbols = ["BTCUSDT", "ETHUSDT", "SOLUSDT", "ADAUSDT", "XRPUSDT"]

[providers.criptoya]
enabled = true
coin = "usdt"
fiat = "ars"
# Empty list = every Argentine venue criptoya returns.
exchanges = []

[providers.coingecko]
enabled = false
quote_currency = "USD"

[notifiers]
plugins = []
# Add "telegram" and/or "email" once their credentials are in .env.
default_channels = ["log"]
