# Copy this file to .env and fill in the channels you want to use.
# Never commit .env.

# --- Telegram (optional) ---------------------------------------------------
# Create a bot with @BotFather, then get your chat id from:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# BOT_TOKEN=123456789:AA...
# CHAT_ID=-100...

# --- Email / SMTP (optional) ----------------------------------------------
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SENDER_EMAIL=you@gmail.com
# SENDER_PASSWORD=your_app_password
# RECIPIENT_EMAIL=you@gmail.com,alerts@example.com

# --- Optional configuration overrides -------------------------------------
# CT_CONFIG=/absolute/path/to/config.toml
# CT_DATABASE_URL=sqlite:////absolute/path/to/crypto_tracking.db
# CT_HOST=127.0.0.1
# CT_PORT=5001
# CT_LOG_LEVEL=INFO
# CT_RETENTION_DAYS=180
# CT_BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
